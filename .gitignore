# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
npm-debug.log*
.env*.local
.env

# database
prisma/*.db
prisma/*.db-journal
# database backups hold real client records — names, emails, what people came
# to talk about. They are made before every schema change and must never be
# committed. NOTE: eight of these were already tracked before this rule
# existed; this stops new ones, it does not untrack the old ones.
prisma/*.db.backup-*
prisma/*.db.rebrand-backup-*

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# uploaded client avatars — faces of real people, kept out of /public and out
# of git. Served only through /api/profile/avatar/[file], which checks the caller.
/private/

# Size Lab: what was resized in the browser, pending application to source
design-changes.jsonl
