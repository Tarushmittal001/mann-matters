DATABASE_URL="file:./dev.db"
AUTH_SECRET="use-a-long-random-secret"

ADMIN_EMAIL="admin@mannmatters.in"
ADMIN_PASSWORD=""

# Shared password for the six seeded practitioner accounts
# (<expert-id>@mannmatters.in, e.g. ananya-iyer@mannmatters.in).
# Leave blank to skip creating them.
EXPERT_PASSWORD=""

# Set to 1 to also seed a demo calendar for the first practitioner —
# a live session, one starting soon, and a past week of closed sessions.
SEED_DEMO=""

# Email delivery for verification links.
# Leave RESEND_API_KEY blank in dev — links are printed to the server console.
# In production, set a Resend API key and a verified from-address.
RESEND_API_KEY=""
EMAIL_FROM="mann Matters <hello@mannmatters.in>"
ADMIN_PASSWORD="your-admin-password"

# Phone OTP delivery. Leave blank locally; the development API returns the OTP
# to the sign-in screen. Configure all three in production.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Claude-backed Manu assistant. Required for non-crisis replies.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# Privacy-conscious public page analytics. Private/auth/crisis routes are excluded in code.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Error tracking. SENTRY_AUTH_TOKEN is needed only while uploading source maps in CI.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
