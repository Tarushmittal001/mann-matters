# Postgres on Neon (neon.tech). Use a separate Neon branch per environment:
# a "dev" branch on your laptop, the main branch only in production.
# DATABASE_URL = the POOLED connection string (host contains "-pooler")
# DIRECT_URL   = the direct connection string (same, without "-pooler"); used by migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# "development" | "ci" | "production". Test tooling (integration tests,
# scripts/test-logins.mjs) refuses to run unless this is development or ci.
APP_ENV="development"
AUTH_SECRET="use-a-long-random-secret"

ADMIN_EMAIL="admin@emoraa.com"
ADMIN_PASSWORD=""

# Shared password for the six seeded practitioner accounts
# (<expert-id>@emoraa.com, e.g. ananya-iyer@emoraa.com).
# Leave blank to skip creating them.
EXPERT_PASSWORD=""

# Set to 1 to also seed a demo calendar for the first practitioner —
# a live session, one starting soon, and a past week of closed sessions.
SEED_DEMO=""

# Email delivery.
#
# lib/email.ts tries three transports in order and uses the first that is
# configured: Gmail SMTP, then Resend, then the server console.
#
#  1. Gmail SMTP - the only one that can send from a @gmail.com address.
#     GMAIL_APP_PASSWORD is a 16-character Google "app password", not the
#     account password; 2FA must be on for Google to issue one.
#  2. Resend - cannot send from a gmail address. EMAIL_FROM must be on a
#     domain verified in Resend (or onboarding@resend.dev).
#  3. Neither set - links are printed to the server console. Fine in dev.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
RESEND_API_KEY=""
EMAIL_FROM="Emoraa <connect@emoraa.com>"

# Where the "for institutions" enquiry form sends to. Falls back to EMAIL_FROM.
ENQUIRY_TO=""

# Only for scripts/test-logins.mjs, which signs in as a seeded practitioner to
# check the expert portal. Never needed in production.
TEST_EXPERT_PASSWORD=""

# Phone OTP delivery. Leave blank locally; the development API returns the OTP
# to the sign-in screen. Configure all three in production.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Claude-backed Manu assistant. Required for non-crisis replies.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Privacy-conscious public page analytics. Private/auth/crisis routes are excluded in code.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Error tracking. SENTRY_AUTH_TOKEN is needed only while uploading source maps in CI.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
