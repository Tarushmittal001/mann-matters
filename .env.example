# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs — generate a long random string
AUTH_SECRET=""

# Seeded admin account (run: npx prisma db seed)
ADMIN_EMAIL="admin@emoraa.in"
ADMIN_PASSWORD=""

# --- Email delivery -------------------------------------------------------
# Providers are tried in this order: Gmail SMTP, then Resend, then a console
# fallback. With neither configured, the verification link is printed to the
# server console AND shown on the signup screen (development builds only).
#
# Option 1 — Gmail SMTP. The only option that can send *from* a @gmail.com
# address. GMAIL_APP_PASSWORD is a 16-character App Password, not your Google
# password: turn on 2-Step Verification, then visit
# https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
#
# Option 2 — Resend. It will NOT send from a gmail address; you must verify a
# domain with them and set EMAIL_FROM to an address on that domain (or use
# onboarding@resend.dev, which can only deliver to your own Resend account).
RESEND_API_KEY=""
EMAIL_FROM="Emoraa <hello@emoraa.in>"
