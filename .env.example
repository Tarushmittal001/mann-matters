# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs — generate a long random string
AUTH_SECRET=""

# Seeded admin account (run: npx prisma db seed)
ADMIN_EMAIL="admin@mannmatters.in"
ADMIN_PASSWORD=""

# Email delivery for verification links.
# Leave RESEND_API_KEY blank in dev — links are printed to the server console.
# In production, set a Resend API key and a verified from-address.
RESEND_API_KEY=""
EMAIL_FROM="mann Matters <hello@mannmatters.in>"
